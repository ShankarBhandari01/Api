{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "command": "npm run start:dev",
      "name": "Developer Mode",
      "request": "launch"
    },
    {
      "type": "node-terminal",
      "command": "npm run start:single",
      "name": "Start Single (Dev Mode)",
      "request": "launch"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Program",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}\\app.js",
      "outFiles": ["${workspaceFolder}/**/*.js"]
    }
  ]
}
